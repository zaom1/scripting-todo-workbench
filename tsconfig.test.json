{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".build",
    "rootDir": ".",
    "types": [],
    "lib": ["ES2020"],
    "noEmitOnError": false
  },
  "include": ["types.ts", "parse.ts", "logic.ts", "store.ts", "tests/**/*.ts"]
}
